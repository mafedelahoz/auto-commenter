# .gitignore

# Personal/company data
Products/

# Actual activity data (keep templates)
tracking/reddit/*.md
!tracking/reddit/template.md
tracking/quora/*.md
!tracking/quora/template.md
tracking/tripadvisor/*.md
!tracking/tripadvisor/template.md

# Actual leads data (real lead info about real third-party users — never commit)
leads/*.md

# Playwright MCP scraped page snapshots (may contain real page content, names, etc.)
.playwright-mcp/

# Personal personalization files (users should create their own)
.claude/skills/reddit-commenter/resources/personalization_reddit.md.personal
.claude/skills/reddit-commenter/resources/product.md.personal

# Environment settings
.env
.env.local
*.env

# MCP
.mcp/cache/
Perplexity-Comet-MCP/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Backup files
*_backup/
*.backup
*.bak

# Temporary files
*.tmp
*.swp
*~

# Node.js
node_modules/
npm-debug.log*
